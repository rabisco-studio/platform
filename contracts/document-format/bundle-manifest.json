{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rabisco-studio/platform/main/contracts/document-format/bundle-manifest.json",
  "title": "Bundle Manifest Schema",
  "description": "Manifesto do bundle .rbsc.zip",
  "type": "object",
  "required": [
    "schema_version",
    "created_at",
    "tile_count",
    "checksum"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "tile_count": {
      "type": "integer",
      "minimum": 0
    },
    "checksum": {
      "type": "object",
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "blake3"
          ]
        },
        "value": {
          "type": "string"
        }
      }
    }
  }
}
